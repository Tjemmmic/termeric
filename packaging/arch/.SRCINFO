pkgbase = termeric-git
	pkgdesc = GPU-accelerated terminal emulator with a warm, turmeric-inspired theme
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/Tjemmmic/termeric
	arch = x86_64
	license = MIT
	license = Unicode-3.0
	makedepends = cargo
	makedepends = git
	makedepends = ncurses
	makedepends = pkgconf
	depends = brotli
	depends = fontconfig
	depends = gcc-libs
	depends = glibc
	depends = libx11
	depends = libxkbcommon
	depends = openssl
	depends = wayland
	depends = zlib
	depends = zstd
	optdepends = mesa: Mesa Vulkan/OpenGL drivers, including the documented software-renderer fallback
	optdepends = vulkan-icd-loader: Vulkan renderer backend
	provides = termeric
	conflicts = termeric
	options = !debug
	options = !lto
	source = termeric::git+https://github.com/Tjemmmic/termeric.git
	sha256sums = SKIP

pkgname = termeric-git
