# Maintainer: Termeric Contributors <Tjemmmic@users.noreply.github.com>

pkgname=termeric-git
_pkgname=termeric
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="GPU-accelerated terminal emulator themed around roots and rhizomes"
arch=('x86_64')
url="https://github.com/Tjemmmic/termeric"
license=('MIT' 'Unicode-3.0')
depends=(
  'fontconfig'
  'gcc-libs'
  'glibc'
  'libx11'
  'libxkbcommon'
  'wayland'
  'zlib'
)
makedepends=('cargo' 'git' 'ncurses' 'pkgconf')
optdepends=(
  'mesa: Mesa Vulkan/OpenGL drivers, including the documented software-renderer fallback'
  'vulkan-icd-loader: Vulkan renderer backend'
)
provides=('termeric')
conflicts=('termeric')
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')
# Current Rust links x86_64 Linux binaries with rust-lld. Arch's global GCC LTO
# flags produce bundled libgit2 objects that rust-lld cannot consume, so keep
# Cargo's own release optimization while disabling makepkg's cross-language LTO.
options=('!debug' '!lto')

pkgver() {
  cd "${srcdir}/${_pkgname}"
  local base revision short
  base="$(sed -nE 's/^version = "([^"]+)"/\1/p' Cargo.toml | head -n1)"
  revision="$(git rev-list --count HEAD)"
  short="$(git rev-parse --short=7 HEAD)"
  printf '%s.r%s.g%s' "${base}" "${revision}" "${short}"
}

build() {
  cd "${srcdir}/${_pkgname}"
  CARGO_TARGET_DIR="${srcdir}/target" cargo build \
    --workspace --release --locked
}

check() {
  cd "${srcdir}/${_pkgname}"
  CARGO_TARGET_DIR="${srcdir}/target" cargo test \
    --workspace --locked
}

package() {
  cd "${srcdir}/${_pkgname}"

  install -Dm755 "${srcdir}/target/release/termeric" \
    "${pkgdir}/usr/bin/termeric"
  install -Dm644 assets/termeric.desktop \
    "${pkgdir}/usr/share/applications/termeric.desktop"
  local icon
  for icon in assets/icons/hicolor/*/apps/termeric.png; do
    install -Dm644 "${icon}" "${pkgdir}/usr/share/icons/${icon#assets/icons/}"
  done
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md CHANGELOG.md termeric/THIRD_PARTY_NOTICES.md -t \
    "${pkgdir}/usr/share/doc/termeric"

  install -d "${pkgdir}/usr/share/terminfo"
  tic -x -o "${pkgdir}/usr/share/terminfo" \
    assets/terminfo/xterm-termeric.terminfo
}
