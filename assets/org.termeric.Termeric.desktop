[Desktop Entry]
Type=Application
Name=Termeric
GenericName=Terminal
Comment=GPU-accelerated terminal emulator
Exec=termeric
Icon=org.termeric.Termeric
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;command;developer;
StartupNotify=true
StartupWMClass=org.termeric.Termeric
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=termeric --new-window
