(( $+functions[_termeric_commands] )) ||
_termeric_commands() {
    local commands; commands=(
'domain:Persistent terminal domains (experimental)' \
'control:Commands for already-running local Termeric GUI processes' \
'plugin:Termeric declarative plugin management' \
'workspace:Termeric saved workspaces' \
'mcp:Serve MCP tools for Termeric'\''s agents on standard I/O' \
    )
    _describe -t commands 'termeric commands' commands "$@"
}
(( $+functions[_termeric__subcmd__control_commands] )) ||
_termeric__subcmd__control_commands() {
    local commands; commands=(
'list:List bounded window, tab, and pane metadata' \
'wait-launch:Wait for a retained child and return its exit code; timeout does not cancel it' \
'launch-status:Observe the initial child of a retained command launch' \
'get-text:Read bounded presented UTF-8 text from one exact pane' \
'send-text:Send opt-in bounded UTF-8 text to one exact pane' \
'new-window:Create a window using the exact source window'\''s configuration and cwd' \
'launch-window:Launch exact argv and non-secret environment overrides in a new window' \
'new-tab:Create a local tab in one exact stable window' \
'launch-tab:Launch exact argv and non-secret environment overrides in a local tab' \
'split-pane:Split one exact stable local pane and return the new pane ID' \
'focus-window:Request native focus for one exact stable window' \
'select-tab:Select one exact stable tab without focusing its native window' \
'focus-pane:Select the tab and focus one exact stable pane' \
'close-window:Schedule one exact stable native window to close' \
'close-tab:Schedule one exact stable local tab to close' \
'close-pane:Close one exact stable local pane immediately' \
'move-tab:Move one exact local tab to a zero-based visual index' \
'move-pane:Move one exact local pane beside an exact destination pane' \
'resize-window:Request an exact native window inner size in physical pixels' \
'resize-divider:Set one exact local divider to 100-900 thousandths' \
    )
    _describe -t commands 'termeric control commands' commands "$@"
}
