(( $+functions[_termeric_commands] )) ||
_termeric_commands() {
    local commands; commands=(
'domain:Keep terminals running in a background daemon, here or over SSH (experimental)' \
'control:Script the windows, tabs, and panes of a running Termeric (experimental)' \
'plugin:Install and manage plugins' \
'workspace:List saved workspaces' \
'mcp:Serve Termeric'\''s agent tools to a coding agent over MCP (experimental)' \
    )
    _describe -t commands 'termeric commands' commands "$@"
}
(( $+functions[_termeric__subcmd__control_commands] )) ||
_termeric__subcmd__control_commands() {
    local commands; commands=(
'list:List windows, tabs, panes, and dividers with their IDs' \
'wait-launch:Wait for a launched program to exit, then exit with its code' \
'launch-status:Show whether a launched program is still running, or how it exited' \
'get-text:Print the text on a pane'\''s screen, and optionally some scrollback' \
'send-text:Type text into a pane; needs \[security\] allow_gui_control_input = true' \
'new-window:Open a window like the source window, in its focused tab'\''s directory' \
'launch-window:Run a program in a new window, without a shell' \
'new-tab:Open a shell tab and print its ID' \
'launch-tab:Run a program in a new tab, without a shell' \
'split-pane:Split a pane and print the new pane'\''s ID' \
'focus-window:Ask the desktop to focus a window; refused on Wayland, where the compositor decides' \
'select-tab:Select a tab without raising its window' \
'focus-pane:Select a tab and focus one of its panes' \
'close-window:Close a window' \
'close-tab:Close a tab and end its programs' \
'close-pane:Close a pane and end its program; a tab'\''s last pane closes only with the tab' \
'move-tab:Move a tab to a position in the same or another window and print its new ID' \
'move-pane:Move a pane next to a pane in another tab, keeping its program running' \
'resize-window:Ask for a window size in physical pixels; the window manager may adjust it' \
'resize-divider:Set the ratio of the split at one divider' \
    )
    _describe -t commands 'termeric control commands' commands "$@"
}
